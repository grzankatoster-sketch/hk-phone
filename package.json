{
  "name": "reception-panel",
  "version": "1.7.3",
  "description": "Panel przekazania zmiany recepcji — Conrad Comfort",
  "main": "electron/main.cjs",
  "author": "Conrad Comfort",
  "contributors": [
    "grzankatoster-sketch"
  ],
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "vite",
    "lint": "node scripts/security-lint.cjs",
    "migrations:check": "node scripts/check-migrations.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cash": "node scripts/cash-logic-tests.mjs",
    "test:logic": "node scripts/test-roomtype-notify-logic.mjs",
    "sim:sejf": "node scripts/sim-nocna-sejf-300.mjs",
    "sim:apt": "node scripts/sim-hk-apt-report.mjs",
    "test:live:tasks": "node scripts/test-manager-task-routing.mjs",
    "test:live:roomtype": "node scripts/test-roomtype-live-sync.mjs",
    "hk:auto": "node scripts/hk-automation/service.cjs",
    "hk:auto:once": "node scripts/hk-automation/service.cjs --once",
    "hk:auto:test": "node scripts/hk-automation/test-parser.cjs",
    "whatsapp:bot": "node scripts/whatsapp-bot/bot.mjs",
    "build": "vite build",
    "electron:dev": "concurrently -k \"vite --force\" \"wait-on http://localhost:5173 && cross-env ELECTRON_IS_DEV=true electron .\"",
    "electron:dev\\": "npm run electron:dev",
    "predist": "npm run lint && npm run migrations:check",
    "dist": "npm run build && electron-builder --win --x64",
    "prerelease": "npm run lint && npm run migrations:check",
    "release": "npm run build && electron-builder --win --x64 --publish always",
    "dist:manager": "electron-builder --win --x64 --config electron-builder.manager.json",
    "release:manager": "electron-builder --win --x64 --publish always --config electron-builder.manager.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@whiskeysockets/baileys": "^6.7.23",
    "dotenv": "^16.4.7",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^11.0.0",
    "imapflow": "^1.0.195",
    "jspdf": "^2.5.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.383.0",
    "mailparser": "^3.7.2",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^6.0.227",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.8",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "pl.conradcomfort.reception",
    "productName": "Panel Recepcji Conrad Comfort",
    "copyright": "Copyright © 2026 Conrad Comfort. Wszelkie prawa zastrzeżone.",
    "extraMetadata": {
      "creator": "Conrad Comfort",
      "copyright": "Copyright © 2026 Conrad Comfort. Wszelkie prawa zastrzeżone."
    },
    "publish": {
      "provider": "github",
      "owner": "grzankatoster-sketch",
      "repo": "conrad-comfort-releases",
      "private": false,
      "releaseType": "release"
    },
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "scripts/hk-automation/lib/**/*.cjs"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "Conrad Comfort"
    },
    "nsis": {
      "artifactName": "Panel-Recepcji-Conrad-Comfort-Setup-${version}.${ext}",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Panel Recepcji"
    }
  }
}
